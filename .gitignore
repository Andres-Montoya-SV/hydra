# Secrets and authorized-scope (never commit)
.env
config/.env
/scope.txt
# The real, domain-specific reverse-proxy config (docs/DEPLOYMENT.md) —
# Caddyfile.example is the committed template.
/Caddyfile

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Hydra run artifacts (keep empty directory placeholders)
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep
*.db
reports/*.md
reports/*.json
reports/*.html
reports/*.bak

# Docker Compose bind-mount data (docs/DOCKER.md) — host-side persistent
# state for containerized runs, never repo content.
/docker-data/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# A real captured Wompi sandbox webhook (scripts/capture_wompi_webhook.py)
# contains a real customer's own email/name — never committed. Dropped in
# locally by an operator to activate
# tests/test_wompi_real_capture_replay.py's otherwise-skipped test; see
# that file's own docstring and docs/PAID_API_DESIGN.md's operator
# runbook for exactly where this goes and how to redact it first.
/tests/fixtures/wompi_real_capture.json
