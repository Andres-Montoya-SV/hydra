# Hydra API (docs/PAID_API_DESIGN.md) — environment configuration.
#
# Copy this to the repo root as `.env` (the file docker-compose.yml's
# `env_file:` line reads, and the file api/settings.py::load_api_settings
# loads via python-dotenv): `cp api/.env.example .env`, then edit.
#
# This is a SEPARATE config surface from `config/.env.example` (the
# `hydra` CLI/pipeline service's own settings, `config.settings.Settings`)
# — see api/settings.py's own module docstring for why. If you are
# deploying ONLY the API (docs/DEPLOYMENT.md), you generally only need
# THIS file, not config/.env.example: every account's own scans construct
# `config.settings.Settings` directly (`api/tenancy.py::account_settings`),
# never via `Settings.from_env()`, so none of config/.env.example's
# `ENABLE_*`/tool-path variables are read for an API-triggered scan at
# all — every account gets the SAME fixed tool selection (the dataclass's
# own hardcoded defaults) regardless of what's in the environment. This
# is deliberate account isolation (a shared server-level env var
# controlling every tenant's scan behavior would be a real multi-tenancy
# leak), not an oversight — but it does mean copying config/.env.example
# into an API-only deployment's `.env` accomplishes nothing for scan
# behavior. If you are ALSO running the `hydra` CLI service from the same
# docker-compose.yml (a separate, non-API use of this same image), copy
# config/.env.example too — the two files' variables never collide.

# --- Where account/scan data lives -----------------------------------
# Default: <repo_root>/api_data — inside the Docker image this resolves
# to /app/api_data, which docker-compose.yml already mounts a volume at;
# no need to set this for the documented Docker deployment path.
HYDRA_API_DATA_DIR=

# --- Rate limiting / abuse controls -----------------------------------
HYDRA_API_RATE_LIMIT_PER_MINUTE=60
HYDRA_API_ACCOUNT_CREATION_RATE_LIMIT_PER_IP_PER_DAY=3
HYDRA_API_EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# --- Admin (temporary MVP credential for POST /admin/wompi/reconcile) --
# Unset = that endpoint refuses every request (fail closed). Generate a
# real random value for production, e.g. `openssl rand -hex 32`.
HYDRA_API_ADMIN_TOKEN=

# --- Email delivery (Postmark, postmarkapp.com) ------------------------
# Both of the next two must be set TOGETHER or NOT AT ALL — the app
# refuses to boot otherwise (api/settings.py::validate_email_provider_config).
# Unset (both) = ConsoleEmailSender: verification/alert emails are only
# logged, never actually sent. Fine for a first deploy/smoke test, not
# for real users.
POSTMARK_SERVER_TOKEN=
HYDRA_API_EMAIL_FROM=
HYDRA_API_EMAIL_FROM_NAME=Hydra

# --- Wompi billing (El Salvador — docs.wompi.sv, NOT docs.wompi.co) ----
# Real OAuth2 client-credentials pair from the Wompi merchant dashboard —
# an operator secret, never exposed to any Hydra API client.
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
# One pre-created EnlacePagoRecurrente URL per paid tier (Part D.1) —
# unset means POST /account/subscription returns 503 for that tier
# rather than a broken link.
HYDRA_WOMPI_LINK_URL_MEDIUM=
HYDRA_WOMPI_LINK_URL_PRO=
HYDRA_WOMPI_LINK_URL_ULTRA=

# --- Durable scan queue -------------------------------------------------
HYDRA_API_MAX_CONCURRENT_SCANS=3
HYDRA_API_SCAN_POLL_INTERVAL_SECONDS=0.5
HYDRA_API_SCAN_HEARTBEAT_INTERVAL_SECONDS=30.0
HYDRA_API_SCAN_STALE_AFTER_SECONDS=120
HYDRA_API_SCAN_MAX_RETRIES=3

# --- Billing enforcement / data retention purge ------------------------
HYDRA_API_RECONCILIATION_INTERVAL_SECONDS=86400
HYDRA_API_RETENTION_PURGE_BATCH_SIZE=200
# OFF by default (real deletion happens) — set to "true" to rehearse a
# purge cycle without actually deleting anything.
HYDRA_API_RETENTION_PURGE_DRY_RUN=false

# --- Automated backups (api/backup_worker.py) --------------------------
HYDRA_API_BACKUP_INTERVAL_SECONDS=86400
HYDRA_API_BACKUP_RETENTION_COUNT=7
# Unset = local-only backups (still real, still work, but won't survive
# this host's disk dying). Set this before going live.
HYDRA_API_BACKUP_S3_BUCKET=
HYDRA_API_BACKUP_S3_PREFIX=hydra-backups
# Only needed for a non-AWS S3-compatible provider (DigitalOcean Spaces,
# Backblaze B2, Cloudflare R2). Leave unset for real AWS S3.
HYDRA_API_BACKUP_S3_ENDPOINT_URL=
HYDRA_API_BACKUP_S3_REGION=
# Read directly by boto3, not Hydra-specific — the standard AWS SDK
# credential env vars every S3-compatible provider's own docs use.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Continuous monitoring (docs/PAID_API_DESIGN.md's dated section) --
HYDRA_API_MONITORING_POLL_INTERVAL_SECONDS=3600
HYDRA_API_MONITORING_PASSIVE_INTERVAL_HOURS=24
HYDRA_API_MONITORING_ACTIVE_INTERVAL_HOURS=168
HYDRA_API_MONITORING_BATCH_SIZE=500
HYDRA_API_MONITORING_ASSET_CEILING=5000
HYDRA_API_MONITORING_CYCLE_TIME_BUDGET_SECONDS=300
HYDRA_API_MONITORING_MAX_DOMAINS_PER_EMAIL=20

# --- Observability -------------------------------------------------------
# Unset = error tracking off, no separate flag needed.
SENTRY_DSN=
# "text" (default, human-readable) or "json" (structured logs).
HYDRA_API_LOG_FORMAT=text

# --- Local development / test overrides — NEVER set these in production --
# Each lets a DNS/HTTP/Wompi/Postmark check be pointed at a local test
# server instead of the real internet/real providers. Domain verification
# (Part A) and billing (Part D) make REAL checks by default; these exist
# only so this project's own test suite (and a from-scratch local smoke
# test) doesn't need real DNS propagation or a real Wompi/Postmark
# account. Leaving all of these unset is the only supported production
# configuration.
HYDRA_API_DEV_DNS_NAMESERVER=
HYDRA_API_DEV_DNS_PORT=
HYDRA_API_DEV_WELL_KNOWN_BASE_URL=
HYDRA_API_DEV_WOMPI_ID_BASE_URL=
HYDRA_API_DEV_WOMPI_API_BASE_URL=
HYDRA_API_DEV_POSTMARK_SEND_URL=
