# =============================================================================
# Hydra Attack Surface Intelligence Configuration
# Copy this file to .env and customize for your bug bounty program.
# =============================================================================

# --- Program Metadata (optional, used in reports only) ---
PROGRAM_NAME=
PROGRAM_PLATFORM=HackerOne

# --- Directories ---
OUTPUT_DIRECTORY=output
LOGS_DIRECTORY=logs
REPORTS_DIRECTORY=reports

# --- Tool Binary Paths (must be on PATH or absolute paths) ---
SUBFINDER_PATH=subfinder
DNSX_PATH=dnsx
HTTPX_PATH=httpx
NAABU_PATH=naabu
KATANA_PATH=katana
HAKRAWLER_PATH=hakrawler
GAU_PATH=gau
WAYBACKURLS_PATH=waybackurls
NUCLEI_PATH=nuclei
ASSETFINDER_PATH=assetfinder
UNFURL_PATH=unfurl
ANEW_PATH=anew
JQ_PATH=jq
AMASS_PATH=amass
NMAP_PATH=nmap
THEHARVESTER_PATH=theHarvester
SSLYZE_PATH=sslyze
WAFW00F_PATH=wafw00f
FFUF_PATH=ffuf
DNSTWIST_PATH=dnstwist
GITLEAKS_PATH=gitleaks
# No WHOIS_PATH: modules/whois.py uses a native Python client
# (core/collection/whois_client.py), never the system `whois` binary — see
# docs/HARDENING_ROUND2_P1.md, Task 2 (a WHOIS_PATH setting existed here
# until this round and was removed for doing nothing).

# --- Execution Settings ---
TIMEOUT=300
THREADS=50
RATE_LIMIT=150
HTTPX_THREADS=50
USER_AGENT=hydra/1.0
# TCP WHOIS + DNS fallback; 20s leaves room when :43 accepts but returns nothing.
ASN_LOOKUP_TIMEOUT=20
CTLOGS_TIMEOUT=15
CTLOGS_DELAY_SECONDS=2
PORT_VERIFY_TIMEOUT=120
PORT_VERIFY_MAX_HOSTS=50
PORT_VERIFY_MAX_PORTS_PER_HOST=100
PORT_VERIFY_CONCURRENCY=4
# Re-probe naabu's first-pass open ports a second time before trusting them.
# Some shared-hosting/anti-scan middleboxes complete TCP handshakes for a
# different random sample of ports on every scan pass; requiring a port to
# reproduce on both passes filters this noise out. Disable only if you scan
# infrastructure you know does not exhibit this behavior and want faster runs.
NAABU_CONFIRM_OPEN_PORTS=true
NAABU_CONFIRM_DELAY_SECONDS=5
# Before trusting ANY naabu port result for a host, probe canary ports with
# nmap -sV (NOT naabu — DreamHost-style tarpits respond differently to
# lightweight SYN probes than to a full connect+service-detect handshake;
# naabu also silently fails with "no valid ipv4..." which previously
# produced false tarpit_suspected:false with no auditable evidence).
# Timeout must accommodate slow tarpit responses (~165s observed for 4 ports).
NAABU_TARPIT_CHECK=true
NAABU_TARPIT_CANARY_COUNT=4
NAABU_TARPIT_OPEN_THRESHOLD=2
# Patient canary pass may take ~3–5m on slow tarpits (manual evidence ~165s).
NAABU_TARPIT_TIMEOUT=360
# Per-query WHOIS timeout (not the global TIMEOUT). Retries with backoff.
WHOIS_TIMEOUT=25
WHOIS_RETRIES=2
WHOIS_RETRY_DELAY_SECONDS=5
THREAT_INTEL_TIMEOUT=15
THREAT_INTEL_CONCURRENCY=4
BROWSER_PROBE_TIMEOUT=15
BROWSER_PROBE_MAX_HOSTS=20
# httpx re-authorizes and follows each redirect hop itself (never the
# binary's own -follow-redirects) up to this many hops before stopping.
HTTPX_MAX_REDIRECT_HOPS=10
LOG_LEVEL=INFO
# Reserved for a future output-format selector; not yet wired to report
# generation (all report formats are currently generated unconditionally).
DEFAULT_OUTPUT_FORMAT=json

# --- Fail-Closed Operational Privacy ---
# Strict mode refuses to run without an explicit HTTP(S) CONNECT proxy. It
# blocks direct DNS, WHOIS, ASN, port scans, and tools whose proxy behavior has
# not been verified. Proxy operators can still observe traffic.
STRICT_OPSEC=false
# OUTBOUND_PROXY_URL=http://username:password@proxy.example:8080

# --- Optional Files ---
# RESOLVERS_FILE=/path/to/resolvers.txt
# WORDLIST=/path/to/wordlist.txt
# NOTE: WORDLIST is validated (must be a readable file) but not yet consumed
# by any plugin — no brute-force subdomain plugin reads it today. Leave unset
# unless/until that feature is implemented.

# --- Feature Flags (true/false) ---
ENABLE_NAABU=false
ENABLE_KATANA=false
ENABLE_HAKRAWLER=false
ENABLE_GAU=false
ENABLE_WAYBACKURLS=false
ENABLE_NUCLEI=false
# nuclei's own templates can declare interactsh (OOB) callbacks to
# ProjectDiscovery's public collaborator servers, which the confinement
# proxy would otherwise (correctly) refuse — leave false unless you accept
# that unproxied third-party contact.
NUCLEI_ENABLE_INTERACTSH=false
ENABLE_ASSETFINDER=false
ENABLE_UNFURL=false
ENABLE_ANEW=false
ENABLE_JQ=false
# amass v5 (what Homebrew installs today) is confirmed incompatible with
# this plugin's CLI usage (-o flag removed) — `check-tools` will refuse to
# mark it runnable and tell you why. See docs/DOCKER.md's native-install
# table and docs/FINAL_PROJECT_AUDIT.md before enabling.
ENABLE_AMASS=false
ENABLE_WHOIS=true
ENABLE_ASN_LOOKUP=true
ENABLE_CTLOGS=true
# Runs only when ENABLE_NAABU=true. Confirms Naabu findings with nmap -sV.
ENABLE_PORT_VERIFY=true
ENABLE_THREAT_INTEL=false
ENABLE_BROWSER_PROBE=false
# Probe random improbable subdomains before trusting passive enumeration.
ENABLE_WILDCARD_CHECK=true
WILDCARD_CANARY_COUNT=3
# Probe a random nonexistent path on each live host before trusting HTTP 200.
ENABLE_SOFT404_CHECK=true
SOFT404_TIMEOUT=10
SOFT404_MAX_HOSTS=50
SOFT404_CONCURRENCY=8
# Passive DNS lookup (Mnemonic, no key needed; optional second provider
# below) for out-of-scope certificate siblings observed via ctlogs — never
# resolves them directly, only asks a fixed third party what it has
# historically seen.
ENABLE_PASSIVE_DNS=false
PASSIVE_DNS_TIMEOUT=15
PASSIVE_DNS_DELAY_SECONDS=6
PASSIVE_DNS_MAX_CANDIDATES=25
# SECURITYTRAILS_API_KEY=

# Reuse a plugin's prior artifact for identical input + network mode
# instead of re-running it. The cache key includes the SCOPE_FILE and
# researcher-attribution identity in effect (hardening round 1) — it is
# never reused across a scope/attribution change, only within one.
ENABLE_CACHE=true
CACHE_TTL_SECONDS=86400

# --- Active probes (DISABLED by default — require ownership/authorization) ---
# Parameter discovery: GETs with crafted query params against live URLs.
# Detects influence/reflection only — never injects exploit payloads.
ENABLE_PARAM_FUZZ=false
PARAM_FUZZ_TIMEOUT=10
PARAM_FUZZ_MAX_URLS_PER_HOST=5
PARAM_FUZZ_DELAY_MS=200
PARAM_FUZZ_BODY_DELTA_PCT=5
# Cloud bucket enumeration: unauthenticated existence checks on S3/GCS/Azure.
# Does not download object contents beyond observing a public listing.
ENABLE_CLOUD_BUCKET_ENUM=false
CLOUD_BUCKET_ENUM_TIMEOUT=10
CLOUD_BUCKET_ENUM_DELAY_MS=150
# Opt-in, separate from ENABLE_CLOUD_BUCKET_ENUM itself: authorizes actually
# connecting to brand-derived candidate bucket hostnames (not just generating
# them). Both this AND ENABLE_CLOUD_BUCKET_ENUM must be true.
CLOUD_BUCKET_ENUM_AUTHORIZE_DERIVED=false

# CVE correlation (OSV.dev, no API key). Optional WPScan token for WordPress.
ENABLE_VULN_MATCH=true
VULN_MATCH_TIMEOUT=15
# WPSCAN_API_TOKEN=

# HTTP security-header audit (uses headers already collected by httpx).
ENABLE_SECURITY_HEADERS=true

# Email/personnel OSINT (theHarvester) — passive, hardcoded to
# duckduckgo,yahoo only (never widened by settings — see
# modules/theharvester.py). Requires a separate Python 3.14 + uv setup;
# see docs/DOCKER.md.
ENABLE_THEHARVESTER=false
THEHARVESTER_TIMEOUT=180

# TLS/certificate posture (sslyze). Active — connects to the target's
# HTTPS endpoints. pip install -r requirements-optional.txt.
ENABLE_SSLYZE=false
SSLYZE_TIMEOUT=120

# WAF/CDN fingerprinting (wafw00f). Active — sends crafted requests to
# the target's own alive URLs. pip install -r requirements-optional.txt.
ENABLE_WAFW00F=false
WAFW00F_TIMEOUT=60

# Technology Intelligence enrichment (WhatWeb). httpx remains Hydra's
# primary technology provider; WhatWeb is optional secondary enrichment.
# Active: requests only already-alive, authorized URLs; redirects are disabled.
ENABLE_WHATWEB=false
WHATWEB_TIMEOUT=30
WHATWEB_THREADS=10
WHATWEB_MAX_URLS=20
# WHATWEB_PATH=whatweb

# Hidden endpoint/content discovery (ffuf). Active — wordlist-based brute
# force against each known host, like param_fuzz.py but for paths, not
# parameters. Disabled by default: the most request-heavy active plugin
# in this project. Default wordlist is a small, curated ~180-entry list
# (modules/data/ffuf_wordlist_quick.txt), not a huge generic one — set
# FFUF_WORDLIST_PATH to opt into a larger, slower, operator-supplied
# list. Consults modules/soft404_check.py's own signal (skips a host it
# already flagged) in addition to ffuf's own -ac auto-calibration.
ENABLE_FFUF=false
FFUF_TIMEOUT=180
# FFUF_WORDLIST_PATH=/path/to/wordlist.txt
FFUF_EXTENSIONS=.bak,.old,.zip,.sql
FFUF_RATE_LIMIT=50
FFUF_THREADS=20
# Real, enforced per-host ceiling (ffuf's own -maxtime-job) — confirmed
# by testing that ffuf genuinely stops early, not just accepts the flag.
FFUF_MAX_TIME_PER_HOST=120
FFUF_MAX_HOSTS=10
# Domain permutation / typosquat monitoring (modules/dnstwist.py) — a
# BRAND-PROTECTION signal, not a target-infrastructure vulnerability.
# Generates typosquat/homoglyph/bit-flip candidates of your own domain
# and checks which are registered. Only passive DNS/WHOIS lookups are
# performed — dnstwist has no --proxy flag at all (confirmed against its
# real, current CLI), so its own optional active content-fetching flags
# (banners/phash/lsh/mxcheck) are never enabled: Hydra cannot apply its
# own SSRF/confinement discipline to a raw connection dnstwist itself
# makes to an unrelated, attacker-influenceable third-party host. Results
# are stored in their own dedicated table, never merged into your own
# discovered hosts — see modules/dnstwist.py's own docstring.
ENABLE_DNSTWIST=false
DNSTWIST_TIMEOUT=180
DNSTWIST_THREADS=20
# A registered permutation younger than this many days is flagged
# "freshly registered" — a real, if imperfect, phishing-setup signal.
DNSTWIST_FRESH_REGISTRATION_DAYS=90
# Leaked-secrets detection in public GitHub repositories
# (modules/github_secrets.py). Passive with respect to the TARGET (never
# connects to the target's own infrastructure) — a real third-party API
# integration + `git clone` + `gitleaks` scan of public repos only. The
# raw secret value is NEVER stored — only rule/file/line/commit metadata.
# GITHUB_ORG (an explicit org/user name) is always preferred when set —
# its public repos are listable with no token at all. Without it, GitHub's
# code-search API is used as a best-effort fallback, but that endpoint
# requires GITHUB_TOKEN even for public code (GitHub's own current
# requirement, confirmed against their real API docs) — with neither set,
# discovery is skipped with a clear warning, not a silent empty result.
ENABLE_GITHUB_SECRETS=false
GITLEAKS_TIMEOUT=120
# GITHUB_ORG=your-org-name
# GITHUB_TOKEN=
GITHUB_SECRETS_CLONE_DEPTH=50
GITHUB_SECRETS_MAX_REPOS=5
GITHUB_SECRETS_INCLUDE_FORKS=false
# Subdomain takeover detection (modules/sub_takeover.py). Active for
# fingerprint-type signatures only — one safe GET per candidate against
# the target's own already-resolved subdomain (never the third-party
# CNAME target). Built-in (stdlib + vendored fingerprint database), no
# separate install. See modules/data/takeover_fingerprints.json.
ENABLE_SUB_TAKEOVER=false
SUB_TAKEOVER_TIMEOUT=10

# Fail-closed authorized scope (copy scope.example.txt to scope.txt).
# SCOPE_FILE=scope.txt

# Bounded discovery (observe freely; collect only in-scope follow-ups).
# MAX_DISCOVERY_DEPTH=1
# MAX_FOLLOWUP_INDICATORS=50
# MAX_DOMAINS_PER_SOURCE=20
# MAX_COLLECTION_BUDGET=200
# MAX_HTTP_PROBES=200
# MAX_DNS_PROBES=200
# MAX_RUNTIME=3600
# MAX_ENTITIES=5000
# MAX_RELATIONSHIPS=20000
# ENABLE_FOLLOWUP_COLLECTION=true
# Intelligence-graph caps below this line are all fail-closed (the run
# stops accepting more of that kind, it never drops existing data or
# writes dummy rows) — same "bounded, not unbounded" contract as the caps
# above, just at finer grain (per certificate, per relationship signal).
# MAX_CT_NAMES_PER_CERTIFICATE=200
# MAX_CERTIFICATES=500
# MAX_IPS=2000
# MAX_URL_ENTITIES=4000
# MAX_TECHNOLOGY_ENTITIES=500
# MAX_FOLLOWUPS_PER_RELATIONSHIP=20
# MAX_RELATIONSHIPS_PER_SIGNAL=64

# Comma-separated domains you own — anything else triggers external-target
# mode (conservative defaults: fewer opt-in active plugins). Also settable
# per-run with `run --external`, regardless of this list.
# OWNED_DOMAINS=
# EXTERNAL_TARGET_MODE=false

# Slack/Discord webhook for scan diffs (silent no-op when unset).
# WEBHOOK_URL=

# URLhaus now requires a free Auth-Key. Create one at:
# https://auth.abuse.ch/ (sign in, then copy the Auth-Key from your profile).
URLHAUS_API_KEY=

# Reportability agent (optional, opt-in) — uses Claude and/or OpenAI to
# check a finding's eligibility against a program's own rules text.
# Skipped cleanly with a clear message if the selected provider's key is
# unset; only consulted by the standalone `python app.py
# assess-reportability` command, never by `run`. See
# docs/REPORTABILITY_AGENT_DESIGN.md. IMPORTANT: agreement between two
# LLMs (even with --adversarial-provider) does not constitute proof that a
# vulnerability exists or is in scope — this is a triage aid, never a
# substitute for reading the program's own rules yourself.
#
# Get an Anthropic key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model used for eligibility assessment — see design doc Part B.3 for why
# this default was chosen. Override for a harder-to-classify program.
ANTHROPIC_MODEL=claude-sonnet-5
# Get an OpenAI key at https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Which provider `assess-reportability` uses by default; --provider
# overrides this per invocation. Must be "anthropic" or "openai".
REPORTABILITY_PROVIDER=anthropic
# Unset (default) = adversarial cross-validation disabled. Set to a
# DIFFERENT provider than REPORTABILITY_PROVIDER to have that second
# provider review (not independently re-classify) the primary provider's
# verdicts; any real disagreement is reported as UNCERTAIN, not resolved
# in either provider's favor. Doubles API spend when enabled.
REPORTABILITY_ADVERSARIAL_PROVIDER=
# Hard ceiling on findings assessed in one assess-reportability pass — the
# command refuses (never silently truncates) a run that exceeds this.
REPORTABILITY_MAX_FINDINGS_PER_BATCH=50

# Hypothesis engine (optional, opt-in) — reuses the same Anthropic/OpenAI
# keys above to propose investigation leads from a run's already-
# correlated relationships/entities. Only consulted by the standalone
# `python app.py suggest-hypotheses` command, never by `run`. See
# docs/HYPOTHESIS_ENGINE_DESIGN.md. Every factual claim a hypothesis makes
# is mechanically verified against the real SQLite data for that run —
# never trusted on the LLM's word.
#
# Which provider `suggest-hypotheses` uses by default; --provider
# overrides this per invocation. Must be "anthropic" or "openai".
HYPOTHESIS_PROVIDER=anthropic
# Unset (default) = reasoning-soundness review disabled. Set to a
# DIFFERENT provider than HYPOTHESIS_PROVIDER to have that second provider
# review (not independently generate) the primary provider's already-
# produced hypotheses. Doubles API spend when enabled.
HYPOTHESIS_ADVERSARIAL_PROVIDER=
# Hard ceiling on relationships considered in one suggest-hypotheses pass
# — the command refuses (never silently truncates) a run that exceeds
# this.
HYPOTHESIS_MAX_RELATIONSHIPS_PER_BATCH=200

# SECURITY: Browser Probe actively visits and executes remote page content.
# Run it only in a disposable, network-restricted container or VM—not on the
# analyst's primary workstation.

# SECURITY: Parameter Discovery and Cloud Bucket Enumeration are active probes
# against the target (or third-party cloud endpoints derived from the brand).
# Enable only when you own the asset or have explicit bug-bounty authorization.
# Neither module uses exploit payloads — existence / reflection / listing only.

# --- Bug Bounty Custom Headers ---
# Required for programs that mandate researcher identification.
# Option 1 (recommended — works for any program, not just HackerOne): a
# program-mandated header with any name — "Name: value", sent with every
# active request against the target itself, never to fixed third parties
# (OSV.dev, crt.sh, WHOIS, URLhaus). Suppressed under STRICT_OPSEC.
# RESEARCHER_ATTRIBUTION_HEADER=X-HackerOne-Research: your_h1_handle

# Option 2: a dedicated convenience variable specifically for HackerOne's
# own documented header ("X-HackerOne-Research: <username>", per
# docs.hackerone.com's Traffic Identification article) — equivalent to
# RESEARCHER_ATTRIBUTION_HEADER above with that exact header name; use
# Option 1 directly for any other program's own header convention.
X_HACKERONE_RESEARCHER=your-h1-username

# Option 3: JSON object or comma-separated Header: value pairs, for
# setting multiple arbitrary headers at once
# HTTP_CUSTOM_HEADERS={"X-HackerOne-Research":"your-username","X-Custom":"value"}
# HTTP_CUSTOM_HEADERS=X-HackerOne-Research:your-username,X-Bugcrowd:your-username

# Program-mandated User-Agent attribution (Bugcrowd's convention: "include
# the string 'bugcrowd' in your User-Agent") — appended in parentheses to
# the normal User-Agent. Use RESEARCHER_ATTRIBUTION_HEADER for a program
# that wants a custom *header* instead; set both if a program asks for both.
# Suppressed under STRICT_OPSEC.
# ATTRIBUTION_USER_AGENT=
