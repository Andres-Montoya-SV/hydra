# =============================================================================
# Hydra Attack Surface Intelligence Configuration
# Copy this file to .env and customize for your bug bounty program.
# =============================================================================

# --- Program Metadata (optional, used in reports only) ---
PROGRAM_NAME=
PROGRAM_PLATFORM=HackerOne

# --- Directories ---
OUTPUT_DIRECTORY=output
LOGS_DIRECTORY=logs
REPORTS_DIRECTORY=reports

# --- Tool Binary Paths (must be on PATH or absolute paths) ---
SUBFINDER_PATH=subfinder
DNSX_PATH=dnsx
HTTPX_PATH=httpx
NAABU_PATH=naabu
KATANA_PATH=katana
HAKRAWLER_PATH=hakrawler
GAU_PATH=gau
WAYBACKURLS_PATH=waybackurls
NUCLEI_PATH=nuclei
ASSETFINDER_PATH=assetfinder
UNFURL_PATH=unfurl
ANEW_PATH=anew
JQ_PATH=jq
WHOIS_PATH=whois
NMAP_PATH=nmap

# --- Execution Settings ---
TIMEOUT=300
THREADS=50
RATE_LIMIT=150
HTTPX_THREADS=50
USER_AGENT=hydra/1.0
# TCP WHOIS + DNS fallback; 20s leaves room when :43 accepts but returns nothing.
ASN_LOOKUP_TIMEOUT=20
CTLOGS_TIMEOUT=15
CTLOGS_DELAY_SECONDS=2
PORT_VERIFY_TIMEOUT=120
PORT_VERIFY_MAX_HOSTS=50
PORT_VERIFY_MAX_PORTS_PER_HOST=100
PORT_VERIFY_CONCURRENCY=4
# Re-probe naabu's first-pass open ports a second time before trusting them.
# Some shared-hosting/anti-scan middleboxes complete TCP handshakes for a
# different random sample of ports on every scan pass; requiring a port to
# reproduce on both passes filters this noise out. Disable only if you scan
# infrastructure you know does not exhibit this behavior and want faster runs.
NAABU_CONFIRM_OPEN_PORTS=true
NAABU_CONFIRM_DELAY_SECONDS=5
# Before trusting ANY naabu port result for a host, probe canary ports with
# nmap -sV (NOT naabu — DreamHost-style tarpits respond differently to
# lightweight SYN probes than to a full connect+service-detect handshake;
# naabu also silently fails with "no valid ipv4..." which previously
# produced false tarpit_suspected:false with no auditable evidence).
# Timeout must accommodate slow tarpit responses (~165s observed for 4 ports).
NAABU_TARPIT_CHECK=true
NAABU_TARPIT_CANARY_COUNT=4
NAABU_TARPIT_OPEN_THRESHOLD=2
# Patient canary pass may take ~3–5m on slow tarpits (manual evidence ~165s).
NAABU_TARPIT_TIMEOUT=360
# Per-query WHOIS timeout (not the global TIMEOUT). Retries with backoff.
WHOIS_TIMEOUT=25
WHOIS_RETRIES=2
WHOIS_RETRY_DELAY_SECONDS=5
THREAT_INTEL_TIMEOUT=15
THREAT_INTEL_CONCURRENCY=4
BROWSER_PROBE_TIMEOUT=15
BROWSER_PROBE_MAX_HOSTS=20
LOG_LEVEL=INFO
# Reserved for a future output-format selector; not yet wired to report
# generation (all report formats are currently generated unconditionally).
DEFAULT_OUTPUT_FORMAT=json

# --- Fail-Closed Operational Privacy ---
# Strict mode refuses to run without an explicit HTTP(S) CONNECT proxy. It
# blocks direct DNS, WHOIS, ASN, port scans, and tools whose proxy behavior has
# not been verified. Proxy operators can still observe traffic.
STRICT_OPSEC=false
# OUTBOUND_PROXY_URL=http://username:password@proxy.example:8080

# --- Optional Files ---
# RESOLVERS_FILE=/path/to/resolvers.txt
# WORDLIST=/path/to/wordlist.txt
# NOTE: WORDLIST is validated (must be a readable file) but not yet consumed
# by any plugin — no brute-force subdomain plugin reads it today. Leave unset
# unless/until that feature is implemented.

# --- Feature Flags (true/false) ---
ENABLE_NAABU=false
ENABLE_KATANA=false
ENABLE_HAKRAWLER=false
ENABLE_GAU=false
ENABLE_WAYBACKURLS=false
ENABLE_NUCLEI=false
ENABLE_ASSETFINDER=false
ENABLE_UNFURL=false
ENABLE_ANEW=false
ENABLE_JQ=false
ENABLE_WHOIS=true
ENABLE_ASN_LOOKUP=true
ENABLE_CTLOGS=true
# Runs only when ENABLE_NAABU=true. Confirms Naabu findings with nmap -sV.
ENABLE_PORT_VERIFY=true
ENABLE_THREAT_INTEL=false
ENABLE_BROWSER_PROBE=false
# Probe random improbable subdomains before trusting passive enumeration.
ENABLE_WILDCARD_CHECK=true
WILDCARD_CANARY_COUNT=3
# Probe a random nonexistent path on each live host before trusting HTTP 200.
ENABLE_SOFT404_CHECK=true
SOFT404_TIMEOUT=10
SOFT404_MAX_HOSTS=50
SOFT404_CONCURRENCY=8

# --- Active probes (DISABLED by default — require ownership/authorization) ---
# Parameter discovery: GETs with crafted query params against live URLs.
# Detects influence/reflection only — never injects exploit payloads.
ENABLE_PARAM_FUZZ=false
PARAM_FUZZ_TIMEOUT=10
PARAM_FUZZ_MAX_URLS_PER_HOST=5
PARAM_FUZZ_DELAY_MS=200
PARAM_FUZZ_BODY_DELTA_PCT=5
# Cloud bucket enumeration: unauthenticated existence checks on S3/GCS/Azure.
# Does not download object contents beyond observing a public listing.
ENABLE_CLOUD_BUCKET_ENUM=false
CLOUD_BUCKET_ENUM_TIMEOUT=10
CLOUD_BUCKET_ENUM_DELAY_MS=150

# CVE correlation (OSV.dev, no API key). Optional WPScan token for WordPress.
ENABLE_VULN_MATCH=true
VULN_MATCH_TIMEOUT=15
# WPSCAN_API_TOKEN=

# HTTP security-header audit (uses headers already collected by httpx).
ENABLE_SECURITY_HEADERS=true

# Fail-closed authorized scope (copy scope.example.txt to scope.txt).
# SCOPE_FILE=scope.txt

# Bounded discovery (observe freely; collect only in-scope follow-ups).
# MAX_DISCOVERY_DEPTH=1
# MAX_FOLLOWUP_INDICATORS=50
# MAX_DOMAINS_PER_SOURCE=20
# MAX_COLLECTION_BUDGET=200
# MAX_HTTP_PROBES=200
# MAX_DNS_PROBES=200
# MAX_RUNTIME=3600
# MAX_ENTITIES=5000
# MAX_RELATIONSHIPS=20000
# ENABLE_FOLLOWUP_COLLECTION=true

# Slack/Discord webhook for scan diffs (silent no-op when unset).
# WEBHOOK_URL=

# URLhaus now requires a free Auth-Key. Create one at:
# https://auth.abuse.ch/ (sign in, then copy the Auth-Key from your profile).
URLHAUS_API_KEY=

# SECURITY: Browser Probe actively visits and executes remote page content.
# Run it only in a disposable, network-restricted container or VM—not on the
# analyst's primary workstation.

# SECURITY: Parameter Discovery and Cloud Bucket Enumeration are active probes
# against the target (or third-party cloud endpoints derived from the brand).
# Enable only when you own the asset or have explicit bug-bounty authorization.
# Neither module uses exploit payloads — existence / reflection / listing only.

# --- Bug Bounty Custom Headers ---
# Required for programs that mandate researcher identification.
# Option 1: dedicated variable (recommended)
X_HACKERONE_RESEARCHER=your-h1-username

# Option 2: JSON object or comma-separated Header: value pairs
# HTTP_CUSTOM_HEADERS={"X-HackerOne-Researcher":"your-username","X-Custom":"value"}
# HTTP_CUSTOM_HEADERS=X-HackerOne-Researcher:your-username,X-Bugcrowd:your-username
